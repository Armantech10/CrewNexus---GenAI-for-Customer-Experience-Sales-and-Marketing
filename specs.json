  "decision_engine_architecture": {
    "description": "Core orchestration system that analyzes user messages and routes to appropriate agents",
    "modules": [
      {
        "name": "Data Models & Enums",
        "path": "backend/agents/models.py",
        "classes": [
          "Intent (Enum)",
          "Sentiment (Enum)",
          "Action (Enum)",
          "AgentType (Enum)",
          "UserContext (DataClass)",
          "IntentAnalysis (DataClass)",
          "SentimentAnalysis (DataClass)",
          "DecisionResult (DataClass)",
          "AgentResponse (DataClass)",
          "AnalyticsMetadata (DataClass)",
          "FinalResponse (DataClass)"
        ],
        "purpose": "Type-safe data structures for decision pipeline"
      },
      {
        "name": "Intent Detection Service",
        "path": "backend/services/intent_detector.py",
        "class": "IntentDetector",
        "methods": [
          "detect(message, context) -> IntentAnalysis",
          "_pattern_match(message) -> Optional[tuple[Intent, float]]",
          "_llm_classify(message, context) -> IntentAnalysis",
          "_extract_keywords(message) -> List[str]"
        ],
        "features": [
          "Fast pattern matching (< 50ms)",
          "LLM fallback for complex cases",
          "Caching with Redis (1hr TTL)",
          "Confidence scoring"
        ],
        "intents_supported": [
          "inquiry",
          "purchase",
          "support",
          "complaint",
          "feedback",
