  "deployment": {
    "strategy": "Progressive (Docker Compose → Kubernetes)",
    "docker_compose": {
      "file": "infrastructure/docker/docker-compose.yml",
      "services": [
        {
          "name": "api",
          "image": "python:3.11-slim",
          "build": "./backend",
          "ports": [
            "8000:8000"
          ],
          "environment": [
            "REDIS_URL=redis://redis:6379",
            "QDRANT_URL=http://qdrant:6333"
          ],
          "depends_on": [
            "redis",
            "qdrant"
          ],
          "healthcheck": {
            "test": "curl -f http://localhost:8000/health || exit 1",
            "interval": "30s",
            "timeout": "10s",
            "retries": 3
          },
          "volumes": [
            "./backend:/app"
          ]
        },
        {
          "name": "frontend",
          "image": "node:20-alpine",
          "build": "./frontend",
          "ports": [
            "3000:3000"
          ],
          "environment": [
            "NEXT_PUBLIC_API_URL=http://localhost:8000"
          ],
          "depends_on": [
            "api"
          ]
        },
        {
          "name": "redis",
          "image": "redis:7-alpine",
          "ports": [
            "6379:6379"
          ],
          "volumes": [
            "redis_data:/data"
          ],
          "command": "redis-server --appendonly yes"
        },
        {
          "name": "qdrant",
          "image": "qdrant/qdrant:latest",
          "ports": [
            "6333:6333"
          ],
          "volumes": [
            "qdrant_data:/qdrant/storage"
          ]
        },
        {
          "name": "postgres",
          "image": "postgres:16-alpine",
          "ports": [
            "5432:5432"
          ],
          "environment": [
            "POSTGRES_DB=genai_platform",
            "POSTGRES_USER=postgres",
            "POSTGRES_PASSWORD=postgres"
          ],
          "volumes": [
            "postgres_data:/var/lib/postgresql/data"
          ]
        }
      ],
      "volumes": [
        "redis_data",
        "qdrant_data",
        "postgres_data"
      ],
      "networks": [
        "genai_network"
      ]
    },
    "kubernetes": {
      "enabled": false,
      "note": "K8s manifests available for production scaling, based on OPEA patterns",
      "path": "infrastructure/kubernetes/"
    }
