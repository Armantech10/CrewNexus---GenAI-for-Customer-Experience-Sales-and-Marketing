{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "version": {
            "type": "string"
        },
        "generated_at": {
            "type": "string"
        },
        "project": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "key_features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "name",
                "description"
            ]
        },
        "architecture": {
            "type": "object"
        },
        "ui_requirements": {
            "type": "object"
        },
        "integration_points": {
            "type": "array"
        }
    },
    "required": [
        "version",
        "project"
    ]
}